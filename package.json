    "@aws-sdk/client-sesv2": "3.1152.0",
    "@aws-sdk/client-sns": "3.1152.0",
    "@aws-sdk/client-socialmessaging": "3.1152.0",
    "@aws-sdk/client-sqs": "3.1152.0",
    "@aws-sdk/credential-providers": "3.1152.0",
